generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  LIVE
  SIMULATED
  ON_DEMAND
}

model Channel {
  id                 String          @id @default(cuid())
  slug               String          @unique @db.VarChar(100)
  name               String          @db.VarChar(255)
  description        String?
  genre              String?         @db.VarChar(255)
  city               String?         @db.VarChar(120)
  frequency          String?         @db.VarChar(24)
  type               ChannelType
  streamUrl          String?         @map("stream_url")
  cycleStart         DateTime?       @map("cycle_start") @db.Timestamptz(6)
  currentTitle       String?         @map("current_title") @db.VarChar(255)
  currentArtist      String?         @map("current_artist") @db.VarChar(255)
  currentAlbum       String?         @map("current_album") @db.VarChar(255)
  metadataUpdatedAt  DateTime?       @map("metadata_updated_at") @db.Timestamptz(6)
  active             Boolean         @default(true)
  segments           RadioSegment[]
  episodes           PodcastEpisode[]
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([active, type])
  @@map("channels")
}

model RadioSegment {
  id              String   @id @default(cuid())
  channelId       String   @map("channel_id")
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  position        Int
  title           String   @db.VarChar(255)
  artist          String?  @db.VarChar(255)
  audioUrl        String   @map("audio_url")
  durationSeconds Int      @map("duration_seconds")

  @@unique([channelId, position])
  @@index([channelId, position])
  @@map("radio_segments")
}

model PodcastEpisode {
  id              String   @id @default(cuid())
  channelId       String   @map("channel_id")
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title           String   @db.VarChar(255)
  description     String?
  audioUrl        String   @map("audio_url")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  durationSeconds Int?     @map("duration_seconds")

  @@index([channelId, publishedAt(sort: Desc)])
  @@map("podcast_episodes")
}
